<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.haedong.erp.employee.EmployeeMapper">

    <sql id="employeeColumns">
        id, name, job_type, login_id, password, role, enabled,
        last_login_at, created_at, updated_at
    </sql>

    <select id="findByLoginId" resultType="com.haedong.erp.employee.Employee">
        SELECT <include refid="employeeColumns"/>
        FROM hd_employee
        WHERE login_id = #{loginId}
    </select>

    <update id="updateLastLoginAt">
        UPDATE hd_employee
        SET last_login_at = now()
        WHERE id = #{id}
    </update>

</mapper>