<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.haedong.erp.domains.employee.EmployeeMapper">

    <sql id="employeeColumns">
        id, name, job_type, login_id, password, role, enabled,
        last_login_at, created_at, updated_at
    </sql>

    <select id="findByLoginId" resultType="com.haedong.erp.domains.employee.Employee">
        SELECT <include refid="employeeColumns"/>
        FROM hd_employee
        WHERE login_id = #{loginId}
    </select>

    <update id="updateLastLoginAt">
        UPDATE hd_employee
        SET last_login_at = now()
        WHERE id = #{id}
    </update>

    <sql id="searchCondition">
        <where>
            <if test="keyword != null">
                AND (e.name LIKE '%' || #{keyword} || '%'
                OR e.mobile LIKE '%' || #{keyword} || '%')
            </if>
            <if test="jobType != null">
                AND e.job_type = #{jobType}
            </if>
        </where>
    </sql>

    <select id="search" resultType="com.haedong.erp.domains.employee.EmployeeSummaryResponse">
        SELECT e.id,
        e.name,
        e.job_type,
        e.birth_date,
        e.mobile,
        d.seniority_no,
        e.role,
        e.enabled,
        e.login_id IS NOT NULL AS has_account
        FROM hd_employee e
        LEFT JOIN hd_driver d ON d.employee_name = e.name
        <include refid="searchCondition"/>
        ORDER BY d.seniority_no NULLS LAST, e.name
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM hd_employee e
        <include refid="searchCondition"/>
    </select>

</mapper>